# @BotFather'dan olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenHere

# PostgreSQL ulanish satri (Render PostgreSQL yaratganda "Internal/External Database URL" sifatida beriladi)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/aviakassa

# Operator(lar) buyurtma xabarlarini oladigan chat ID (guruh yoki shaxsiy chat)
# Bir nechta operator bo'lsa vergul bilan ajrating: 111111111,222222222
OPERATOR_CHAT_IDS=111111111

# Render avtomatik beradi (RENDER_EXTERNAL_URL), lokal test uchun kerak emas.
# Boshqa hostingda ishlatilsa shu yerga to'liq domenni yozing (https bilan).
WEBHOOK_URL=

# Render avtomatik beradi, lokal uchun 3000 qoldiring
PORT=3000

# Admin panel/buyurtmalarni ko'rish uchun oddiy parol (ixtiyoriy, /admin route uchun)
ADMIN_PASSWORD=changeme
